{
  "name": "vue3-ts-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint . && stylelint \"src/**/*.{vue,scss,css}\" --allow-empty-input",
    "lint:fix": "biome lint --write . && stylelint \"src/**/*.{vue,scss,css}\" --allow-empty-input",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "axios": "^1.13.6",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/node": "^25.3.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "sass": "^1.97.3",
    "stylelint": "^17.8.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "lint-staged": {
    "*": [
      "biome check --write ."
    ]
  }
}
